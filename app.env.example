# Copy this file to app.env and replace the placeholder values.
# Never commit the real app.env file.
# This file is read only by the FastAPI backend. It is NOT used by docker-compose.yml.
# Generate each secret separately, for example with:
#   python3 -c "import secrets; print(secrets.token_hex(24))"

# --- Backend API ---
API_KEY=replace_me

# --- Limited database role used by n8n (n8n_writer) ---
N8N_WRITER_PASSWORD=replace_me

# --- Groq mock mode (true = no real Groq calls) ---
GROQ_MOCK=false
