# Copy this file to .env and replace the placeholder values.
# Never commit the real .env file.
# This file is passed to the PostgreSQL container, so keep only PostgreSQL variables here.
# The Groq key lives in a separate file: see groq.env.example.

# --- PostgreSQL ---
POSTGRES_DB=your_database_name
POSTGRES_USER=your_database_user
POSTGRES_PASSWORD=your_database_password
